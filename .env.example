# SiteForge environment. Copy to .env.local for local overrides. Never commit real values.
# With NOTHING set, SiteForge runs fully locally: embedded PGlite database + dev login.

# --- Database -----------------------------------------------------------------------------
# Unset  -> embedded PGlite at SITEFORGE_LOCAL_DB_DIR (local development only).
# Set    -> the dedicated SiteForge Postgres/Supabase project. Never a Chef KnifeWorks database.
DATABASE_URL=
SITEFORGE_LOCAL_DB_DIR=.data/pglite
# Comma-separated project refs/hosts SiteForge must refuse to connect to (e.g. the CKW project ref).
SITEFORGE_FORBIDDEN_DB_HOSTS=

# --- Auth ---------------------------------------------------------------------------------
# dev      -> local-only one-click operator login (refused on any Vercel deployment)
# supabase -> SiteForge Supabase Auth (wired up when the SiteForge Supabase project exists)
SITEFORGE_AUTH_MODE=dev
SITEFORGE_DEV_OPERATOR_EMAIL=operator@siteforge.local
# Required on Vercel. At least 32 random characters: `openssl rand -base64 48`
SESSION_SECRET=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Background jobs (Phase 1) ------------------------------------------------------------
APP_BASE_URL=http://localhost:3000
# Shared secret for internal worker calls. Required on Vercel.
JOB_SECRET=
# Vercel Cron bearer secret. Required on Vercel.
CRON_SECRET=

# --- AI (Phase 4) -------------------------------------------------------------------------
# Unset -> the deterministic mock provider is used.
ANTHROPIC_API_KEY=

LOG_LEVEL=info
